# Copy to secret.yaml (gitignored) or apply via Sealed Secrets / External Secrets.
# NEVER commit real values. Placeholders only.
apiVersion: v1
kind: Secret
metadata:
  name: arquitetura-kanban
  namespace: arquitetura-kanban
  labels:
    app.kubernetes.io/name: arquitetura-kanban
type: Opaque
stringData:
  APP_URL: https://CHANGEME_DNS
  DATABASE_URL: postgresql://CHANGEME_USER:CHANGEME@CHANGEME_PG_HOST:5432/CHANGEME_DB
  DATABASE_URL_LISTEN: postgresql://CHANGEME_USER:CHANGEME@CHANGEME_PG_HOST:5432/CHANGEME_DB
  OIDC_ISSUER: https://CHANGEME_CYBERARK_ISSUER
  OIDC_CLIENT_ID: CHANGEME
  OIDC_CLIENT_SECRET: CHANGEME
  OIDC_SCOPES: openid profile email
  AUTH_SECRET: CHANGEME_openssl_rand_base64_32
  # Optional — only if discovery is unreachable from the pods:
  # OIDC_AUTHORIZATION_ENDPOINT: https://CHANGEME/authorize
  # OIDC_TOKEN_ENDPOINT: https://CHANGEME/token
  # OIDC_USERINFO_ENDPOINT: https://CHANGEME/userinfo
  # OIDC_LOGOUT_ENDPOINT: https://CHANGEME/session/end
