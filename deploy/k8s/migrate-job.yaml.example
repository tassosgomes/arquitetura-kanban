# Apply with the NEW image tag BEFORE rolling out the Deployment.
# Do not couple migrate to `next build` (unlike Vercel homologation).
# Replace CHANGEME_* then: kubectl apply -f migrate-job.yaml
apiVersion: batch/v1
kind: Job
metadata:
  name: arquitetura-kanban-migrate
  namespace: arquitetura-kanban
  labels:
    app.kubernetes.io/name: arquitetura-kanban
    app.kubernetes.io/component: migrate
spec:
  backoffLimit: 1
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: arquitetura-kanban
        app.kubernetes.io/component: migrate
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: migrate
          image: CHANGEME_REGISTRY/arquitetura-kanban:CHANGEME_TAG
          imagePullPolicy: IfNotPresent
          command: ["npx", "--no-install", "prisma", "migrate", "deploy"]
          envFrom:
            - secretRef:
                name: arquitetura-kanban
            - configMapRef:
                name: arquitetura-kanban
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
