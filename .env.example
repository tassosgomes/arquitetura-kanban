# Cópia para `.env` (não versionado) e preencha. Sem credenciais reais neste arquivo.
# Logto local: docs/guides/oidc.md §2. Compose: docs/guides/local-development.md.
# Homologação Vercel: docs/guides/homologation.md — não copie este arquivo para a Vercel.

# --- App ---
APP_URL=http://localhost:3000
APP_TIME_ZONE=America/Sao_Paulo

# --- PostgreSQL (Compose) ---
POSTGRES_USER=arquitetura
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=arquitetura
POSTGRES_PORT=5432

# Host (`npm run dev`): hostname localhost.
# Serviço `app` no Compose: o docker-compose.yml sobrescreve o host para `postgres`.
DATABASE_URL=postgresql://arquitetura:CHANGEME@localhost:5432/arquitetura

# Sessão dedicada para LISTEN (T21). Se omitida, a app usa DATABASE_URL.
# Homologação Vercel: URL unpooled / direct — não o pooler em modo transação.
# Réplicas Kubernetes LISTEN na mesma base. Localmente pode repetir DATABASE_URL.
DATABASE_URL_LISTEN=postgresql://arquitetura:CHANGEME@localhost:5432/arquitetura

# --- OIDC (Tech Spec) — valores do Logto Cloud, nunca no git ---
OIDC_ISSUER=https://your-tenant.logto.app/oidc
OIDC_CLIENT_ID=CHANGEME
OIDC_CLIENT_SECRET=CHANGEME
OIDC_SCOPES=openid profile email

# Só se o discovery ({OIDC_ISSUER}/.well-known/openid-configuration) falhar:
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_USERINFO_ENDPOINT=
# OIDC_LOGOUT_ENDPOINT=

# Sessão Auth.js (T07). Gere um valor local, por exemplo: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32-chars-min
